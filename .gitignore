# Virtual environment
.venv/
venv/
ENV/

# Python cache and temporary files
__pycache__/
*.py[cod]
*$py.class
*.bak
*.tmp
*.log

# Project specific uploads/outputs (keep directories but ignore documents)
upload/*
!upload/.gitkeep
output_files/*
!output_files/.gitkeep

# OS specific files
.DS_Store
Thumbs.db
